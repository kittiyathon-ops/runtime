NODE_ENV=development
RUNTIME_PROFILE=PAPER
DRY_RUN=true
LOG_LEVEL=info
SQLITE_PATH=./data/runtime.sqlite
EVENT_QUEUE_CAPACITY=10000
MAX_QUEUE_DEPTH=10000
MAX_REPLAY_LAG=10000
HOT_PATH_WARN_MS=20
STALE_DATA_HALT_MS=1000
LATENCY_HALT_MS=250
MAX_REJECT_RATE=0.2
MAX_EXPOSURE_USD=10000
MAX_DAILY_LOSS_USD=100
MAX_ORDER_NOTIONAL_USD=10
MAX_LEVERAGE=1
MAX_DRAWDOWN_USD=1000
IDEMPOTENCY_CACHE_SIZE=10000
KILL_SWITCH=false
LIVE_TRADING_CONFIRMATION=
ALLOW_MARKET_ORDERS=false
TELEGRAM_ALERTS_ENABLED=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_LANGUAGE=th
TELEGRAM_ALERT_MODE=verbose
BINANCE_SYMBOLS=BTCUSDT
BINANCE_USE_TESTNET=true
BINANCE_FUTURES_REST_URL=https://demo-fapi.binance.com
BINANCE_FUTURES_USER_STREAM_BASE_URL=wss://stream.binancefuture.com
BINANCE_FUTURES_MARKET_WS_BASE_URL=wss://stream.binancefuture.com
